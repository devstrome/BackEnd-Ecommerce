# HTTPS CloudFront preview that fronts the EC2 Nginx origin.
PUBLIC_ORIGIN=https://djpbx0x4mkv17.cloudfront.net

# Canonical website address used in SEO and email links.
SITE_URL=https://belorella.com

# Comma-separated browser origins allowed by the API.
CLIENT_URL=https://belorella.com,https://djpbx0x4mkv17.cloudfront.net

# Path is relative to compose.yaml. For the EC2 clone instructions, this is the
# sibling frontend checkout. Change it if you cloned the frontend elsewhere.
FRONTEND_CONTEXT=../../../frontend

# Optional public frontend settings (never put private keys or secrets here).
NEXT_PUBLIC_SUPPORT_EMAIL=info.belorella@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=01601-886367
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_UBER_CLIENT_ID=
